# Supabase 설정
# Supabase 프로젝트 대시보드 > Project Settings > API 에서 확인할 수 있다.
# 이 값들은 브라우저에 노출되는 anon(public) key이므로 NEXT_PUBLIC_ 접두사가 필요하다.
# (실제 데이터 보호는 anon key가 아니라 Postgres RLS 정책이 담당한다.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 데이터베이스 직접 연결 (마이그레이션 적용 등 로컬 작업 시에만 필요, 앱 런타임에서는 사용하지 않음)
# Supabase 프로젝트 대시보드 > Project Settings > Database 에서 확인할 수 있다.
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# service_role 키 — Supabase 프로젝트 대시보드 > Project Settings > API > service_role secret.
# RLS를 완전히 우회하는 권한이므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것(클라이언트 번들에
# 포함되면 안 됨). app/api/account/delete(회원탈퇴)처럼 서버 라우트 핸들러 내부에서만 사용한다.
# 로컬 개발(.env.local)과 AWS Amplify Hosting 콘솔(앱 설정 > 환경 변수) 양쪽에 등록해야 한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 웹 배포 도메인의 절대 URL(끝에 슬래시 없이). 네이티브 앱(Capacitor)은 자체적으로
# app/api 라우트를 가질 수 없어(정적 export 빌드), 이 값을 이용해 웹에 배포된
# /api/account/delete 등을 절대 URL로 호출한다. 웹 빌드 자체에는 필수가 아니다
# (없으면 상대경로로 폴백).
NEXT_PUBLIC_APP_URL=https://mindsnap.ylia.io
